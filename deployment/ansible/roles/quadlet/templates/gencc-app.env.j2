# gencc-app settings, read by podman as environment variables: one KEY=value
# per line, unquoted (podman keeps quotes as part of the value).
DATABASE_HOST={{ gencc_container_db_host }}
DATABASE_USER={{ gencc_mysql_app_user }}
DATABASE_PASSWORD={{ gencc_mysql_app_password }}
DATABASE_NAME={{ gencc_mysql_database }}
RELEASES_BUCKET={{ gencc_app_releases_bucket }}
{% if gencc_app_trust_proxy %}
TRUST_PROXY={{ gencc_app_trust_proxy }}
{% endif %}
LOG_LEVEL=info

[Unit]
Description=Run gencc-sub update:genes inside container
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sudo -u {{ gencc_deploy_user }} bash -lc 'export XDG_RUNTIME_DIR=/run/user/$(id -u {{ gencc_deploy_user }}); podman exec gencc-sub php artisan update:genes'


[Unit]
Description=Run gencc-sub update:diseases inside container
After=network-online.target
Wants=network-online.target
# Refresh the admin disease audit against the newly imported ontology data.
OnSuccess=gencc-sub-audit-diseases.service

[Service]
Type=oneshot
User={{ gencc_deploy_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ _gencc_deploy_uid.stdout }}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ _gencc_deploy_uid.stdout }}/bus
ExecStart=/usr/bin/podman exec gencc-sub php artisan update:diseases


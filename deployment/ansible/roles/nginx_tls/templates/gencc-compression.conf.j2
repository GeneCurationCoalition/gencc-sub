# Compress text responses for every GenCC site: scripts, styles and JSON, which nginx leaves
# uncompressed by default. Ubuntu's nginx.conf already has `gzip on;` (for text/html only), and
# a second `gzip on` in the same http block is a duplicate directive, so only the rest is here.
# Nothing compressed here carries a secret beside text a request controls (see BREACH).
gzip_types text/css text/plain text/xml text/javascript application/javascript application/json application/problem+json application/xml image/svg+xml;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 1024;

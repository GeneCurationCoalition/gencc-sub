# HTTP-only bootstrap config (used before a certificate exists).
server {
  listen 80;
  server_name {{ gencc_submit_hostname }};

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_pass http://127.0.0.1:{{ gencc_sub_port }};
  }
}

server {
  listen 80;
  server_name {{ gencc_search_hostname }}{% for r in gencc_search_hostname_redirects %} {{ r }}{% endfor %};

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_pass http://127.0.0.1:{{ gencc_search_port }};
  }
}

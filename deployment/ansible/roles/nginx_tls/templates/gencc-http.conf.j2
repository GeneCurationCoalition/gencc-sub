# HTTP-only bootstrap config (used before a certificate exists).
server {
{% if gencc_php_incident_portal_mitigations | bool %}
{% include 'gencc-php-mitigation.conf.j2' %}
{% endif %}

  listen 80;
  server_name {{ gencc_submit_hostname }}{% for r in gencc_submit_hostname_redirects %} {{ r }}{% endfor %};
  # PHP INCIDENT 2026-10: restore the portal's normal limit after patching.
  client_max_body_size {{ '8m' if (gencc_php_incident_portal_mitigations | bool) else '100m' }};

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

{% if gencc_php_incident_portal_offline | bool %}
{% include 'gencc-portal-maintenance.conf.j2' %}

{% else %}
  location / {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_sub_port }};
  }
{% endif %}
}

server {
{% include 'gencc-php-mitigation.conf.j2' %}

  listen 80;
  server_name {{ gencc_search_hostname }}{% for r in gencc_search_hostname_redirects %} {{ r }}{% endfor %};
  # PHP INCIDENT 2026-10: explicitly preserve search's existing tighter limit.
  client_max_body_size 1m;

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_search_port }};
  }
}
{% if gencc_app_hostname is defined %}

server {
{% include 'gencc-php-mitigation.conf.j2' %}

  listen 80;
  server_name {{ gencc_app_hostname }};
  client_max_body_size 1m;

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_app_port }};
  }
}
{% endif %}

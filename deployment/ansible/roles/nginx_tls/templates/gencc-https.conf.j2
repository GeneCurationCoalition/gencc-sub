# TLS termination on-host (Let's Encrypt). HTTP redirects to HTTPS.
# Keep portal and search separate so patched portal uploads can be restored
# while the unpatched search application retains its incident restrictions.
server {
{% if gencc_php_incident_portal_mitigations | bool %}
{% include 'gencc-php-mitigation.conf.j2' %}
{% endif %}

  listen 80;
  server_name {{ gencc_submit_hostname }}{% for r in gencc_submit_hostname_redirects %} {{ r }}{% endfor %};
  client_max_body_size {{ '8m' if (gencc_php_incident_portal_mitigations | bool) else '100m' }};

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
{% include 'gencc-php-mitigation.conf.j2' %}

  listen 80;
  server_name {{ gencc_search_hostname }}{% for r in gencc_search_hostname_redirects %} {{ r }}{% endfor %};
  client_max_body_size 1m;

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}
{% if gencc_app_hostname is defined %}

server {
{% include 'gencc-php-mitigation.conf.j2' %}

  listen 80;
  server_name {{ gencc_app_hostname }};
  client_max_body_size 1m;

  location /.well-known/acme-challenge/ {
    root /var/www/acme-challenge;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}
{% endif %}

# ---------------------------------------------------------------------------
# gencc-sub (submission portal)
# ---------------------------------------------------------------------------
server {
{% if gencc_php_incident_portal_mitigations | bool %}
{% include 'gencc-php-mitigation.conf.j2' %}
{% endif %}

  listen 443 ssl http2;
  server_name {{ gencc_submit_hostname }};

  ssl_certificate     /etc/letsencrypt/live/{{ gencc_letsencrypt_cert_name }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ gencc_letsencrypt_cert_name }}/privkey.pem;

  # PHP INCIDENT 2026-10: restore the portal's normal limit after patching.
  client_max_body_size {{ '8m' if (gencc_php_incident_portal_mitigations | bool) else '100m' }};

  access_log /var/log/nginx/access.log gencc;
  error_log  /var/log/nginx/error.log;

  # -- Security headers ----------------------------------------------------
  add_header Strict-Transport-Security "max-age={{ gencc_hsts_max_age }}" always;
  add_header X-Content-Type-Options    "nosniff" always;
  add_header X-Frame-Options           "SAMEORIGIN" always;
  add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

{% if gencc_php_incident_portal_offline | bool %}
{% include 'gencc-portal-maintenance.conf.j2' %}

{% else %}
  # -- IP blocklist ---------------------------------------------------------
  include /etc/nginx/snippets/gencc-ip-blocklist.conf;

  # -- Bot blocking (exempt paths handled via map) --------------------------
  if ($deny_bot) {
    return 403;
  }

  # -- Connection limit -----------------------------------------------------
  limit_conn conn_per_ip 30;

  # -- Health check (no rate limiting) --------------------------------------
  location = /-/healthz {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_sub_port }};
  }

  # -- Auth endpoints (brute-force protection) ------------------------------
  location ~ ^/(login|register|forgot-password|reset-password) {
    limit_req zone=auth burst=3 nodelay;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_sub_port }};
  }

  # -- PubMed API (intentionally blocked at edge) ---------------------------
  # App routes still exist, but external access stays disabled until a real
  # consumer is identified.
  location ^~ /api/pubmed {
    return 403;
  }

  # -- Fallback (SPA pages, authenticated routes, external API) -------------
  location / {
    limit_req zone=general burst=30 delay=15;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_sub_port }};
  }
{% endif %}
}

# ---------------------------------------------------------------------------
# gencc-search (public search site)
# ---------------------------------------------------------------------------
server {
{% include 'gencc-php-mitigation.conf.j2' %}

  listen 443 ssl http2;
  server_name {{ gencc_search_hostname }};
  # PHP INCIDENT 2026-10: explicitly preserve search's existing tighter limit.
  client_max_body_size 1m;

  ssl_certificate     /etc/letsencrypt/live/{{ gencc_letsencrypt_cert_name }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ gencc_letsencrypt_cert_name }}/privkey.pem;

  access_log /var/log/nginx/access.log gencc;
  error_log  /var/log/nginx/error.log;

  # -- Security headers ----------------------------------------------------
  add_header Strict-Transport-Security "max-age={{ gencc_hsts_max_age }}" always;
  add_header X-Content-Type-Options    "nosniff" always;
  add_header X-Frame-Options           "SAMEORIGIN" always;
  add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

  # -- IP blocklist ---------------------------------------------------------
  include /etc/nginx/snippets/gencc-ip-blocklist.conf;

  # -- Bot blocking (exempt paths handled via map) --------------------------
  if ($deny_bot) {
    return 403;
  }

  # -- Connection limit -----------------------------------------------------
  limit_conn conn_per_ip 30;

  # -- Health check (no rate limiting) --------------------------------------
  location = /-/healthz {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_search_port }};
  }

  # -- Data exports (heavy queries, tight limits) ---------------------------
  location ^~ /download/action/ {
    limit_req  zone=exports burst=2 nodelay;
    limit_conn conn_per_ip 3;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_search_port }};
  }

  # -- Legacy auth pages ----------------------------------------------------
  location ^~ /gencc-members/ {
    limit_req zone=auth burst=3 nodelay;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_search_port }};
  }

  # -- Fallback (browse pages) ----------------------------------------------
  location / {
    limit_req zone=search burst=20 delay=10;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_pass http://127.0.0.1:{{ gencc_search_port }};
  }
}
{% if gencc_app_hostname is defined %}

# ---------------------------------------------------------------------------
# gencc-app (the new public browser, beside gencc-search until cutover)
# ---------------------------------------------------------------------------
server {
{% include 'gencc-php-mitigation.conf.j2' %}

  listen 443 ssl http2;
  server_name {{ gencc_app_hostname }};
  # Nothing is uploaded; the largest request is a query string.
  client_max_body_size 1m;

  ssl_certificate     /etc/letsencrypt/live/{{ gencc_letsencrypt_cert_name }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ gencc_letsencrypt_cert_name }}/privkey.pem;

  access_log /var/log/nginx/access.log gencc;
  error_log  /var/log/nginx/error.log;

  # -- Security headers ----------------------------------------------------
  # The app sends nosniff, X-Frame-Options, Referrer-Policy and its CSP itself;
  # a second X-Frame-Options here would conflict with its own.
  add_header Strict-Transport-Security "max-age={{ gencc_hsts_max_age }}" always;

  # -- IP blocklist ---------------------------------------------------------
  include /etc/nginx/snippets/gencc-ip-blocklist.conf;

  # -- Bot blocking (exempt paths handled via map) --------------------------
  if ($deny_bot) {
    return 403;
  }

  # -- Connection limit -----------------------------------------------------
  limit_conn conn_per_ip 30;

  # Each location passes $request_id as X-Request-Id, which the app logs on
  # every line; a server-level proxy_set_header would be replaced by theirs.

  # -- Health checks (no rate limiting) -------------------------------------
  location ~ ^/-/(healthz|readyz)$ {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:{{ gencc_app_port }};
  }

  # -- File downloads (tight limits; daily quotas behind them) --------------
  location ~ ^/(download/action|conflict-viewer/download)/ {
    limit_req  zone=exports burst=2 nodelay;
    limit_conn conn_per_ip 3;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:{{ gencc_app_port }};
  }

  # -- Scripts, styles and logos (a members page loads 22 logos at once) ----
  location ~ ^/(assets|brand)/ {
    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:{{ gencc_app_port }};
  }

  # -- Fallback (pages and the API) -----------------------------------------
  location / {
    limit_req zone=search burst=20 delay=10;

    include /etc/nginx/snippets/gencc-proxy-params.conf;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:{{ gencc_app_port }};
  }
}
{% endif %}

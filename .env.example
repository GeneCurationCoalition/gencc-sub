# Application Configuration
APP_NAME="GenCC Submission Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gencc_sub
DB_USERNAME=root
DB_PASSWORD=

# Broadcasting & Real-time Updates
# Options: ably, log, null
BROADCAST_DRIVER=null

# Cache, Queue, Session Configuration
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Frontend idle timeout in milliseconds before showing logout warning (default: 900000 = 15 minutes)
SESSION_IDLE_TIMEOUT=900000

# Sanctum Stateful Domains (comma-separated)
# Include all domains/ports where the frontend is served from
# Local: localhost:8001,127.0.0.1:8001
# Docker: Add container hostnames as needed
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8001,127.0.0.1,127.0.0.1:8001

# Session Cookie Domain (leave empty to use request host)
# For local dev: leave empty or set to localhost
# For production: set to your domain (.example.com for subdomains)
SESSION_DOMAIN=

# Upload Processing
# Maximum time (in seconds) for processing large file uploads (default: 600 = 10 minutes)
UPLOAD_TIMEOUT_SECONDS=600

# External API Configuration
# GenCC submission API endpoint
SUBMIT_URL=http://127.0.0.1:8001/api/submit
# GenCC search release API endpoint
RELEASE_URL=http://127.0.0.1:8000/api/release
# GenCC-Search publish token for publishing submissions
GENCC_PUBLISH_TOKEN=

# Performance Monitoring
PULSE_ENABLED=true
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# Security
BCRYPT_ROUNDS=10

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# YAML Import Files (GCS or local paths)
# Used by gencc:import-submitters, gencc:import-users, gencc:import-teams
# For GCS: gs://bucket-name/path/to/file.yaml
# For local: data/submitters.yaml (relative to project root)
GENCC_SUBMITTERS_FILE=gs://gencc/application-private/submitters.yaml
GENCC_USERS_FILE=gs://gencc/application-private/users.yaml
GENCC_TEAMS_FILE=gs://gencc/application-private/teams.yaml

# External API Keys
# NCBI/PubMed API key (increases rate limit from 3 to 10 requests/second)
NCBI_API_KEY=

# OMIM API key for downloading disease data
OMIM_API_KEY=

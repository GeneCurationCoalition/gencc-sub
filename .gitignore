# Development environment files
.env
php81.sh
.envrc
.venv/

# PHP dependencies
/vendor
# NPM dependencies
/node_modules
# JS build output
/public/build
# ClinGen pipeline data
/data/clingen
/scripts/clingen_pipeline/data
# Temporary files created by Claude AI
.claude
.vscode/settings.json

# PM2 logs (stored in storage/logs/)
/storage/logs/pm2-*.log

# Release notes (generated by gencc:release command)
/storage/releases/

# CSV exports (generated by gencc:release command)
/storage/app/public/exports/

# PHPUnit and testing artifacts
.phpunit.result.cache

# Vite dev server
/public/hot

# Laravel storage symlink (created via php artisan storage:link)
/public/storage

# Vue type definitions (auto-generated)
/node_modules/.vue-global-types/

# Python cache
__pycache__/
*.pyc

# Local Python venv for ClinGen sync pipeline (created via `python3 -m venv .venv`)
/.venv/

# Database backups
/data/*.sql

# Excel temporary lock files
/data/~$*.xlsx
.env.bak*

# ignore downloaded files from external sources
data/genemap2.txt
data/mondo-with-equivalents.json
data/mimTitles.txt
data/en_product1.xml
data/gencc-submissions.xlsx
wrapper.env.txt
.env copy.testing

# Local deployment / AI artifacts (keep untracked, reduce `git status` noise)
/.gemini/
/CLAUDE.local.md
/gencc-sub-github-action-deploy-key
/ai/

# Database backups and dumps
/data/backups/
/data/db-dumps/
data/hgnc_complete_set.json

# Terraform
deployment/terraform/**/.terraform/
deployment/terraform/**/.terraform.lock.hcl
deployment/terraform/**/*.tfstate
deployment/terraform/**/*.tfstate.backup
deployment/ansible/gencc-staging-ansible-vault-passphrase.txt

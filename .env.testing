# Testing Environment Configuration
# This file is automatically loaded when APP_ENV=testing
# It OVERRIDES .env to ensure tests NEVER touch the production MySQL database

APP_NAME=GenCCSub
APP_ENV=testing
# Set in tests/CreatesApplication.php
# APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# CRITICAL: Tests MUST use SQLite in-memory database
# This prevents tests from wiping the production MySQL database
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Disable external services during testing
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# Disable performance monitoring
PULSE_ENABLED=false
TELESCOPE_ENABLED=false

# Speed up password hashing in tests
BCRYPT_ROUNDS=4

# Upload Processing (shorter timeout for tests)
UPLOAD_TIMEOUT_SECONDS=60

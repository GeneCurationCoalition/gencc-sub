#!/usr/bin/env bash

set -e

# Check if nvm is installed
if [ ! -d "$HOME/.nvm" ] && [ -z "$NVM_DIR" ]; then
    echo "Error: nvm is not installed. Please install nvm first:"
    echo "  https://github.com/nvm-sh/nvm#installing-and-updating"
    exit 1
fi

# Load nvm
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    source "$NVM_DIR/nvm.sh"
else
    echo "Error: Could not load nvm from $NVM_DIR/nvm.sh"
    exit 1
fi

# Install and use Node 22
echo "Ensuring Node.js 22 is installed..."
nvm install 22

echo "Switching to Node.js 22..."
nvm use 22

echo "Current Node version: $(node -v)"
echo "Current npm version: $(npm -v)"

# Composer
composer install

# npm install
npm install

# npm build
npm run build
